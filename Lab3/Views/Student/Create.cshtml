@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
    string mode = ViewBag.LinkMode ?? "action";
}
<h1 class="h3 mb-2">Thêm sinh viên</h1>
<p class="text-muted">Lab 3 · Kiểm tra dữ liệu nhập bằng Data Annotations</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
@if (mode == "html")
{
    <partial name="_HtmlCreateForm" model="Model" />
}
else if (mode == "route")
{
    <form asp-route="StudentAdd" method="post" enctype="multipart/form-data" class="mt-3">
        <input type="hidden" name="mode" value="route" />
        <partial name="_StudentFields" model="Model" />
    </form>
}
else
{
    <form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3">
        <partial name="_StudentFields" model="Model" />
    </form>
}
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validation-vi.js" asp-append-version="true"></script>
}
