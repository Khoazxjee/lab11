<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/fontawesome/all.min.js" defer></script>
</head>
<body class="sb-nav-fixed">
    <partial name="TopNav" />
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            @await Component.InvokeAsync("Render")
        </div>
        <div id="layoutSidenav_content">
            <main><div class="container-fluid px-3 py-3">@RenderBody()</div></main>
            <footer class="py-4 bg-light mt-auto"><partial name="Footer" /></footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
